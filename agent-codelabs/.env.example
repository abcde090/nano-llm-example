# Copy to .env (adk loads it automatically from the agents/ directory).

# --- Model backend (tracks 1-5): Gemini via AI Studio ---
GOOGLE_API_KEY=your-ai-studio-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Or use Vertex AI instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# Model for all agents (override to taste)
ADK_MODEL=gemini-2.5-flash

# --- Track 5: Location Intelligence ---
# BigQuery billing project for MCP Toolbox queries
BIGQUERY_PROJECT=my-gcp-project
# Google Maps Platform API key (Geocoding + Places APIs enabled)
GOOGLE_MAPS_API_KEY=your-maps-key
